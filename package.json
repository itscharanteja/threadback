{
  "name": "threadback",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run check:bindings && npm run typecheck && npm run check:rust && npm run test:ui",
    "bindings": "$HOME/.cargo/bin/cargo run -p threadback-core --example export_bindings",
    "check:bindings": "$HOME/.cargo/bin/cargo run -p threadback-core --example export_bindings -- --check",
    "typecheck": "tsc -b --pretty false",
    "check:rust": "$HOME/.cargo/bin/cargo check --workspace",
    "test": "$HOME/.cargo/bin/cargo test --workspace",
    "format": "$HOME/.cargo/bin/cargo fmt --all -- --check",
    "tauri": "tauri",
    "demo:reset": "node scripts/reset-demo.mjs",
    "test:ui": "vitest run",
    "demo:attempt-fix": "node scripts/demo-step.mjs attempt-fix",
    "demo:revert-fix": "node scripts/demo-step.mjs revert-fix",
    "demo:drift": "node scripts/demo-step.mjs drift"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
