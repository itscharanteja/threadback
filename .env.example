# Names only. ThreadBack reads no secrets from the environment.
#
# The model connection (endpoint, model ID, timeout, response format) is set in
# the app under "Model". The API key is stored only in the macOS Keychain.

# Where the database lives (default: ~/Library/Application Support/com.threadback.desktop).
THREADBACK_DB=

# Default limits on how much of each command's output `tb run` stores.
THREADBACK_HEAD_BYTES=
THREADBACK_TAIL_BYTES=
